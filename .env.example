NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# Online storage for admin uploads and the product list (needed on hosts like Vercel).
# Vercel dashboard > Storage > Create > Blob, then connect it to the project.
# That adds this token automatically; for local testing copy it here.
BLOB_READ_WRITE_TOKEN=

# Where to keep products and photos:
#   local  = this computer's `storage` folder (ignores the token above)
#   online = Vercel Blob
#   (empty) = automatic: online if the token is set, otherwise local
STORAGE_MODE=

# Optional. Blob store kind: public or private. Empty = detected automatically.
BLOB_ACCESS=
